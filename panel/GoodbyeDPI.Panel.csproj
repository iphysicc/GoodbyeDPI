<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GoodbyeDPI Panel: one exe that installs GoodbyeDPI (with built-in DNS over HTTPS)
    as a Windows service and turns it on and off.
    Targets .NET Framework 4.8, which ships with Windows 10 and 11: nothing to install.
    Build ../dist/x86_64 first (build.ps1), its files are embedded.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GoodbyeDPI-Panel</AssemblyName>
    <RootNamespace>GoodbyeDPI.Panel</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\src\icon.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <Product>GoodbyeDPI Panel</Product>
    <Description>GoodbyeDPI kurulum ve kontrol paneli</Description>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\src\icon.ico" Link="icon.ico" />
    <EmbeddedResource Include="..\dist\x86_64\goodbyedpi.exe" LogicalName="payload/goodbyedpi.exe" />
    <EmbeddedResource Include="..\dist\x86_64\WinDivert.dll" LogicalName="payload/WinDivert.dll" />
    <EmbeddedResource Include="..\dist\x86_64\WinDivert64.sys" LogicalName="payload/WinDivert64.sys" />
  </ItemGroup>

</Project>
